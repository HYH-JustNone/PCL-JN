<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d" x:Class="PageOtherTest"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Orientation="Vertical" Margin="25,25,25,10">
            <local:MyCard Title="百宝箱" Margin="0,0,0,15">
                <WrapPanel Orientation="Horizontal" Margin="25,42,6,10">
                    <local:MyButton x:Name="BtnJrrp" Text="今日人品" Height="35" Margin="0,0,15,12" Width="140" />
                    <local:MyButton x:Name="BtnMemory" Text="内存优化" Height="35" Margin="0,0,15,12" Width="140"
                                    ToolTip="将物理内存占用降低约 1/3，不仅限于 MC！&#xA;如果使用机械硬盘，这可能会导致一小段时间的严重卡顿。&#xA;使用 --memory 参数启动 PCL 可以静默执行内存优化。" />
                    <local:MyButton x:Name="BtnClear" Text="清理游戏垃圾" Height="35" Margin="0,0,15,12" Width="140"
                                    ToolTip="清理 PCL 的缓存与 MC 的日志、崩溃报告等垃圾文件" />
                    <local:MyButton x:Name="BtnClick" Text="千万别点" Height="35" Margin="0,0,15,12" Width="140" ColorType="Red" />
                </WrapPanel>
            </local:MyCard>
            <local:MyCard Title="Mod 备份与回滚" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}"
                               Text="启动前会自动检测 mods 是否发生变化，并把 options.txt、config 与 saves 打包到游戏目录的 PCL\ModBackup 下。回滚只会移动文件，不会删除任何内容。" />
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnBackupNow" Text="立即备份" Height="32" MinWidth="110" Padding="12,0"
                                        Margin="0,0,12,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnCheckModUpdate" Text="检查 Mod 更新" Height="32" MinWidth="130" Padding="12,0"
                                        ToolTip="通过 Modrinth 检查 mods 中的 Mod 是否有新版本（需要联网）" />
                    </WrapPanel>
                    <TextBlock x:Name="LabModUpdateResult" Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap"
                               Visibility="Collapsed" Foreground="{StaticResource ColorBrushGray2}" />
                    <TextBlock x:Name="LabBackupEmpty" Margin="0,14,0,0" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{StaticResource ColorBrushGray2}" Text="还没有备份，启动一次游戏或点击「立即备份」即可生成。" />
                    <StackPanel x:Name="PanBackupList" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardCave" Title="回声洞" Margin="0,0,0,15">
                <TextBlock x:Name="LabCave" Margin="25,39,25,16" FontSize="13.5" IsHitTestVisible="False"
                           Text="反复点击这里可以查看 PCL 作者与各位沙雕网友乱七八糟的留言！"
                           TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}" />
                <local:MyTextButton x:Name="BtnCave" Margin="10,7" Padding="5" Text="投稿"
                                    VerticalAlignment="Top" HorizontalAlignment="Right" />
            </local:MyCard>
            <local:MyCard Title="下载自定义文件" Margin="0,0,0,15">
                <Grid Margin="25,38,25,21">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MinHeight="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="Auto" MinHeight="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="Auto" MinHeight="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,11" Grid.ColumnSpan="5" TextWrapping="Wrap"
                               Text="使用 PCL 的高速多线程下载引擎下载任意文件。请注意，部分网站（例如百度网盘）可能会报错 (403) 已禁止，无法正常下载。" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Top" Margin="0,6,25,0" HorizontalAlignment="Left" Text="下载地址" />
                    <local:MyTextBox x:Name="TextDownloadUrl" Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="1">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateExcept>
                                <local:ValidateExcept.Excepts>
                                    <sys:String>ftp://</sys:String>
                                </local:ValidateExcept.Excepts>
                            </local:ValidateExcept>
                            <local:ValidateHttp />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <TextBlock Grid.Row="3" VerticalAlignment="Top" HorizontalAlignment="Left" Text="保存到" Margin="0,6,25,0" />
                    <local:MyTextBox x:Name="TextDownloadFolder" Grid.Column="1" Grid.Row="3">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateFolderPath UseMinecraftCharCheck="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <TextBlock Grid.Row="5" VerticalAlignment="Top" HorizontalAlignment="Left" Text="文件名" Margin="0,6,25,0" />
                    <local:MyTextBox x:Name="TextDownloadName" Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="5">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateFileName UseMinecraftCharCheck="False" RequireParentFolderExists="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <local:MyTextButton x:Name="BtnDownloadSelect" Grid.Row="3" Grid.Column="2" Text="选择"
                                        VerticalAlignment="Top" Margin="6,2,0,1" Padding="4" />
                    <WrapPanel Margin="-8,7,-8,0" Grid.Row="7" Grid.ColumnSpan="5" HorizontalAlignment="Center">
                        <local:MyButton x:Name="BtnDownloadStart" Margin="8,8,8,0" IsEnabled="False" Text="开始下载"
                                        Height="35" MinWidth="135" Padding="13,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnDownloadOpen" Margin="8,8,8,0" IsEnabled="False" Text="打开文件夹"
                                        Height="35" MinWidth="135" Padding="13,0" />
                    </WrapPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
